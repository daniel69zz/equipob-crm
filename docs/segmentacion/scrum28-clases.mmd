    }
    class AuditoriaAccesoFilter {
        registrar()
        filtrosSegmentacion(request)
    }
    ConsultaSegmentosComponent --> ConsultaSegmentosService
    ConsultaSegmentosService ..> ClientesPorSegmentoController : HTTP via Gateway
    ClientesPorSegmentoController --> FiltroConsultaClientes : valida
    ClientesPorSegmentoController --> RepositorioConsultaClientes
    ClientesPorSegmentoController --> UmbralesConsumo
    UmbralesConsumo ..> UmbralesConsumoController : HTTP interno
    UmbralesConsumoController --> CriterioNivelConsumo

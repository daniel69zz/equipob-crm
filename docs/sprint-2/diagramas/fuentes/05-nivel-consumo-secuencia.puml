@startuml
autonumber
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam titleFontSize 24
skinparam titleFontColor #173955
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #436580
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F4F8FD
skinparam classBorderColor #7294B3
skinparam classFontColor #173955
skinparam classAttributeFontSize 15
skinparam stereotypeFontSize 13
skinparam stereotypeFontColor #58758E
skinparam nodesep 50
skinparam ranksep 58
skinparam linetype polyline
skinparam sequenceParticipantBackgroundColor #EAF1F8
skinparam sequenceParticipantBorderColor #7294B3
skinparam sequenceParticipantFontSize 15
skinparam sequenceLifeLineBorderColor #B7C8D7
skinparam sequenceGroupBackgroundColor #F5F8FB
skinparam sequenceGroupBorderColor #A3B8CA
skinparam sequenceGroupFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceMessageFontSize 16
skinparam sequenceArrowThickness 1.3
skinparam maxMessageSize 300
hide empty members
hide circle
title Clasificar al cliente por nivel de consumo\n<size:14>Historias relacionadas: SCRUM-27</size>\n<size:14>CRM MaxiConecta | Diagrama de secuencia</size>
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/consumo/ClasificadorConsumo.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/consumo/CriterioNivelConsumo.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/consumo/ClasificacionConsumoScheduler.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/indicador/ConsultaIndicadores.java
participant ProcesadorCompras as P
participant ClasificadorConsumo as C
participant AgregadoComprasCliente as A
participant CriterioNivelConsumo as R
participant ClienteNivelConsumoRepository as DB
participant ClienteNivelConsumo as N
P -> C : Actualizar el nivel después de la compra\nreclasificar(idClienteOrigen)
C -> A : Obtener el consumo vigente del cliente\nresumir(identificadores)
A --> C : Cantidad de compras y monto acumulado
C -> R : Determinar el nivel de consumo\nclasificar(valorAcumulado)
R --> C : Bajo, medio, alto o sin nivel
alt Cliente con consumo vigente
  C -> DB : Buscar la clasificación guardada\nfindById(idClienteOrigen)
  DB --> C : Clasificación existente o sin registro
  alt Clasificación existente
    C -> N : Actualizar nivel y monto acumulado\nactualizar(nivel, valorAcumulado)
  else Primera clasificación
    C -> DB : Guardar la clasificación inicial\nsave(clienteNivelConsumo)
  end
else Cliente sin consumo vigente
  C -> DB : Quitar la clasificación anterior\ndeleteById(idClienteOrigen)
end
C --> P : Nivel de consumo actualizado
@enduml

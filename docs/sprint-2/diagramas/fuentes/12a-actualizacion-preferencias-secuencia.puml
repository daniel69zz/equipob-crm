@startuml
autonumber
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam titleFontSize 24
skinparam titleFontColor #173955
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #436580
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F4F8FD
skinparam classBorderColor #7294B3
skinparam classFontColor #173955
skinparam classAttributeFontSize 15
skinparam stereotypeFontSize 13
skinparam stereotypeFontColor #58758E
skinparam nodesep 50
skinparam ranksep 58
skinparam linetype polyline
skinparam sequenceParticipantBackgroundColor #EAF1F8
skinparam sequenceParticipantBorderColor #7294B3
skinparam sequenceParticipantFontSize 15
skinparam sequenceLifeLineBorderColor #B7C8D7
skinparam sequenceGroupBackgroundColor #F5F8FB
skinparam sequenceGroupBorderColor #A3B8CA
skinparam sequenceGroupFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceMessageFontSize 16
skinparam sequenceArrowThickness 1.3
skinparam maxMessageSize 300
hide empty members
hide circle
title Actualizar preferencias con cada compra\n<size:14>Historias relacionadas: SCRUM-42</size>\n<size:14>CRM MaxiConecta | Diagrama de secuencia</size>
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/preferencia/PerfilesPreferencias.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/preferencia/ReceptorPreferencias.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/preferencia/ConstructorPreferencias.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/preferencia/PreferenciasController.java
' Fuente: frontend/crm-web/src/app/features/clientes/preferencias.service.ts
queue "Pub/Sub" as MQ
participant ReceptorPreferencias as R
participant PerfilesPreferencias as P
participant AgregadoConsumoCategorias as A
participant ConstructorPreferencias as C
participant PerfilPreferenciasRepository as DB
MQ ->> R : Entregar el evento de métricas actualizadas\nrecibir(mensaje)
R -> P : Actualizar las preferencias del cliente\nactualizarPorEvento(clienteId, idEvento, tipoEvento)
P -> DB : Comprobar si el evento ya se aplicó\neventoAplicado(idEvento)
DB --> P : Estado del evento
alt Evento nuevo
  P -> A : Leer el consumo vigente del cliente\nconsumirTodo(identificadores)
  A --> P : Historial de compras y devoluciones
  P -> C : Ordenar las categorías del historial vigente\nconstruir(consumo)
  C --> P : Categorías preferidas, ordenadas por consumo
  P -> DB : Guardar las preferencias y su origen\nguardar(clienteId, fecha, categorias, tipoEvento, idEvento)
  DB --> P : PerfilPreferencias actualizado
  P -> DB : Conservar el cambio realizado por el evento\nregistrarActualizacion(idEvento, tipoEvento, anterior, nuevo)
  P --> R : Preferencias actualizadas
else Evento ya aplicado
  P --> R : Preferencias conservadas
end
R --> MQ : Confirmar procesamiento del evento
@enduml

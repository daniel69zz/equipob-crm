@startuml
autonumber
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam titleFontSize 24
skinparam titleFontColor #173955
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #436580
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F4F8FD
skinparam classBorderColor #7294B3
skinparam classFontColor #173955
skinparam classAttributeFontSize 15
skinparam stereotypeFontSize 13
skinparam stereotypeFontColor #58758E
skinparam nodesep 50
skinparam ranksep 58
skinparam linetype polyline
skinparam sequenceParticipantBackgroundColor #EAF1F8
skinparam sequenceParticipantBorderColor #7294B3
skinparam sequenceParticipantFontSize 15
skinparam sequenceLifeLineBorderColor #B7C8D7
skinparam sequenceGroupBackgroundColor #F5F8FB
skinparam sequenceGroupBorderColor #A3B8CA
skinparam sequenceGroupFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceMessageFontSize 16
skinparam sequenceArrowThickness 1.3
skinparam maxMessageSize 300
hide empty members
hide circle
title Analizar la evolución del consumo por categoría\n<size:14>Historias relacionadas: SCRUM-32</size>\n<size:14>CRM MaxiConecta | Diagrama de secuencia</size>
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/evolucion/ConsultaEvolucionConsumo.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/evolucion/FiltroEvolucionConsumo.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/evolucion/ComparacionPeriodos.java
actor "Analista comercial" as U
participant EvolucionConsumoController as C
participant ConsultaEvolucionConsumo as Q
participant AgregadoConsumoCategorias as A
participant CalculoEvolucionConsumo as CAL
participant ComparacionPeriodos as CMP
U -> C : Elegir cliente, fechas, categorías y periodo\nGET /api/comportamiento/clientes/{id}/evolucion-consumo
C -> Q : Obtener la evolución del cliente\nconsultar(identificadores, filtro)
Q -> A : Consultar compras y devoluciones del rango\nconsumir(identificadores, desde, hasta)
A --> Q : Consumo comprado y devuelto por categoría
Q -> CAL : Agrupar el consumo depurado por periodo\ncalcular(periodos, zona, consumo, categoriasFiltro)
CAL --> Q : Series por categoría y totales por periodo
loop Cada categoría
  Q -> CMP : Comparar los periodos de la categoría\ncomparar(serie, indiceBase, periodos)
  CMP --> Q : Consumo y variaciones entre periodos
end
Q --> C : EvolucionConsumo
C --> U : Evolución y comparación por categoría
@enduml

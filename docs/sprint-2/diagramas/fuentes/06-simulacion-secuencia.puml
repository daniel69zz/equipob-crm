@startuml
autonumber
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam titleFontSize 24
skinparam titleFontColor #173955
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #436580
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F4F8FD
skinparam classBorderColor #7294B3
skinparam classFontColor #173955
skinparam classAttributeFontSize 15
skinparam stereotypeFontSize 13
skinparam stereotypeFontColor #58758E
skinparam nodesep 50
skinparam ranksep 58
skinparam linetype polyline
skinparam sequenceParticipantBackgroundColor #EAF1F8
skinparam sequenceParticipantBorderColor #7294B3
skinparam sequenceParticipantFontSize 15
skinparam sequenceLifeLineBorderColor #B7C8D7
skinparam sequenceGroupBackgroundColor #F5F8FB
skinparam sequenceGroupBorderColor #A3B8CA
skinparam sequenceGroupFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceMessageFontSize 16
skinparam sequenceArrowThickness 1.3
skinparam maxMessageSize 300
hide empty members
hide circle
title Simular una regla de segmentación\n<size:14>Historias relacionadas: SCRUM-29</size>\n<size:14>CRM MaxiConecta | Diagrama de secuencia</size>
' Fuente: backend/servicio-segmentacion/src/main/java/com/maxiconecta/crm/segmentacion/simulacion/SimulacionSegmentacion.java
' Fuente: backend/servicio-segmentacion/src/main/java/com/maxiconecta/crm/segmentacion/criterio/CriterioService.java
' Fuente: backend/servicio-segmentacion/src/main/java/com/maxiconecta/crm/segmentacion/criterio/CriterioController.java
actor "Administrador del CRM" as U
participant CriterioController as C
participant SimulacionSegmentacion as S
participant CriterioService as V
participant CriterioRepository as CR
database PostgreSQL as DB
participant ReglaPrioridadSegmento as R
U -> C : Enviar la regla que desea evaluar\nPOST /api/segmentacion/criterios/simular
C -> S : Calcular el efecto de la regla\nsimular(solicitud)
S -> V : Comprobar los datos de la propuesta\nprepararSimulacion(criterioId, regla)
V --> S : Criterio validado
S -> CR : Obtener las reglas de segmentación activas\nactivos()
CR --> S : Criterios del escenario de simulación
S -> DB : Consultar métricas y segmentos actuales
DB --> S : Datos de los clientes
loop Cada cliente con métricas
  S -> R : Elegir segmento con la regla propuesta\nelegir(...)
  R --> S : Segmento simulado del cliente
end
S --> C : Distribución actual, distribución simulada\ny cantidad de clientes que cambiarían
C --> U : Resultado de la simulación
@enduml

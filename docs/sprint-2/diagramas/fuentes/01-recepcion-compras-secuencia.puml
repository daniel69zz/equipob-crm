@startuml
autonumber
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam titleFontSize 24
skinparam titleFontColor #173955
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #436580
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F4F8FD
skinparam classBorderColor #7294B3
skinparam classFontColor #173955
skinparam classAttributeFontSize 15
skinparam stereotypeFontSize 13
skinparam stereotypeFontColor #58758E
skinparam nodesep 50
skinparam ranksep 58
skinparam linetype polyline
skinparam sequenceParticipantBackgroundColor #EAF1F8
skinparam sequenceParticipantBorderColor #7294B3
skinparam sequenceParticipantFontSize 15
skinparam sequenceLifeLineBorderColor #B7C8D7
skinparam sequenceGroupBackgroundColor #F5F8FB
skinparam sequenceGroupBorderColor #A3B8CA
skinparam sequenceGroupFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceMessageFontSize 16
skinparam sequenceArrowThickness 1.3
skinparam maxMessageSize 300
hide empty members
hide circle
title Registrar una compra confirmada\n<size:14>Historias relacionadas: SCRUM-20, SCRUM-23</size>\n<size:14>CRM MaxiConecta | Diagrama de secuencia</size>
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/ingesta/ProcesadorCompras.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/ingesta/IngestaCompras.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/validacion/ReglaContratoCompraConfirmada.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/configuracion/ConfiguracionRabbit.java
actor "Marketplace y Ventas" as V
queue "Pub/Sub" as MQ
participant ReceptorCompras as R
participant IngestaCompras as I
participant BitacoraIngesta as B
participant ProcesadorCompras as P
participant ValidadorEventos as VAL
V ->> MQ : Publicar compra confirmada\ncompra.confirmada
MQ ->> R : Entregar datos de compra\nrecibir(mensaje)
R -> I : Iniciar el registro\nrecibir(contenido)
I -> B : Guardar el evento recibido\nregistrarRecepcion(contenido)
B --> I : Identificador del evento
I -> P : Registrar la compra\nprocesar(idEvento)
P -> VAL : Comprobar los datos del contrato\nvalidar(evento)
alt Datos inválidos
  VAL --> P : Motivo del rechazo
  P --> I : Compra rechazada
  I -> B : Guardar el motivo\nmarcarFallido(idEvento, causa)
else Datos válidos y compra nueva
  VAL --> P : Validación correcta
  P --> I : Compra guardada con sus ítems
else Compra ya registrada
  P --> I : CompraDuplicadaException
  I -> B : Registrar el duplicado\nmarcarDescartado(idEvento, causa)
end
I --> R : Evento atendido
R --> MQ : Confirmar recepción del mensaje
@enduml

@startuml
autonumber
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam titleFontSize 24
skinparam titleFontColor #173955
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #436580
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F4F8FD
skinparam classBorderColor #7294B3
skinparam classFontColor #173955
skinparam classAttributeFontSize 15
skinparam stereotypeFontSize 13
skinparam stereotypeFontColor #58758E
skinparam nodesep 50
skinparam ranksep 58
skinparam linetype polyline
skinparam sequenceParticipantBackgroundColor #EAF1F8
skinparam sequenceParticipantBorderColor #7294B3
skinparam sequenceParticipantFontSize 15
skinparam sequenceLifeLineBorderColor #B7C8D7
skinparam sequenceGroupBackgroundColor #F5F8FB
skinparam sequenceGroupBorderColor #A3B8CA
skinparam sequenceGroupFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceMessageFontSize 16
skinparam sequenceArrowThickness 1.3
skinparam maxMessageSize 300
hide empty members
hide circle
title Detectar cambios en el hábito de compra\n<size:14>Historias relacionadas: SCRUM-34</size>\n<size:14>CRM MaxiConecta | Diagrama de secuencia</size>
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/cambio/DetectorCambiosComportamiento.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/cambio/CriterioCambioComportamiento.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/cambio/DeteccionCambiosScheduler.java
participant DeteccionCambiosScheduler as S
participant DetectorCambiosComportamiento as D
participant AgregadoComprasCliente as A
participant CriterioCambioComportamiento as C
participant EstadoComportamientoClienteRepository as E
participant DeteccionCambioComportamientoRepository as R
[-> S : Iniciar la revisión programada\nejecutar()
S -> D : Evaluar los hábitos de los clientes\ndetectarTodos()
D -> A : Obtener compras del periodo base y del actual\ncomprasPorPeriodo(inicioBase, inicioActual, fin)
A --> D : Cantidades y montos por cliente y periodo
loop Cada cliente
  D -> C : Comparar el hábito actual con el habitual\nevaluar(compras, ventanas)
  C --> D : Estado del cliente y variaciones relevantes
  D -> D : Actualizar el estado del cliente\nguardarEstado(idClienteOrigen, evaluacion, ventanas)
  D -> E : Consultar el estado almacenado\nfindById(idClienteOrigen)
  E --> D : Estado anterior o sin registro
  loop Cada variación relevante
    D -> D : Registrar la variación del cliente\nregistrar(idClienteOrigen, variacion, ventanas)
    D -> R : Buscar una alerta del mismo tipo y dirección\nen el periodo actual
    R --> D : Alerta existente o variación nueva
    opt Variación nueva
      D -> R : Guardar la nueva alerta\nsave(deteccion)
    end
  end
end
D --> S : Clientes evaluados y nuevas alertas
S -->] : Revisión de hábitos completada
@enduml

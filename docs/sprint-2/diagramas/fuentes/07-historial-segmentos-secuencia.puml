@startuml
autonumber
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam titleFontSize 24
skinparam titleFontColor #173955
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #436580
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F4F8FD
skinparam classBorderColor #7294B3
skinparam classFontColor #173955
skinparam classAttributeFontSize 15
skinparam stereotypeFontSize 13
skinparam stereotypeFontColor #58758E
skinparam nodesep 50
skinparam ranksep 58
skinparam linetype polyline
skinparam sequenceParticipantBackgroundColor #EAF1F8
skinparam sequenceParticipantBorderColor #7294B3
skinparam sequenceParticipantFontSize 15
skinparam sequenceLifeLineBorderColor #B7C8D7
skinparam sequenceGroupBackgroundColor #F5F8FB
skinparam sequenceGroupBorderColor #A3B8CA
skinparam sequenceGroupFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceMessageFontSize 16
skinparam sequenceArrowThickness 1.3
skinparam maxMessageSize 300
hide empty members
hide circle
title Consultar el historial de segmentos del cliente\n<size:14>Historias relacionadas: SCRUM-30</size>\n<size:14>CRM MaxiConecta | Diagrama de secuencia</size>
' Fuente: backend/servicio-segmentacion/src/main/java/com/maxiconecta/crm/segmentacion/asignacion/AuditoriaSegmentos.java
' Fuente: backend/servicio-segmentacion/src/main/java/com/maxiconecta/crm/segmentacion/historial/HistorialSegmentos.java
' Fuente: backend/servicio-segmentacion/src/main/java/com/maxiconecta/crm/segmentacion/historial/HistorialSegmentosController.java
' Fuente: backend/servicio-segmentacion/src/main/resources/db/migration/V5__historial_segmentos.sql
' Fuente: frontend/crm-web/src/app/features/clientes/historial-segmentos.service.ts
actor "Analista comercial" as U
participant HistorialSegmentosController as C
participant HistorialSegmentos as H
database PostgreSQL as DB
U -> C : Solicitar los cambios del cliente\nGET /api/segmentacion/clientes/{id}/historial-segmentos
C -> H : Obtener una página del historial\nconsultar(clienteId, pagina, tamanio)
H -> DB : Consultar cambios ordenados del más reciente al más antiguo
DB --> H : Cambios registrados y cantidad total
H --> C : Página de cambios con sus reglas originales
C --> U : Historial de segmentos del cliente
@enduml

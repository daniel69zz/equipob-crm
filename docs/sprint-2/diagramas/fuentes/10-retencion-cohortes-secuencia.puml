@startuml
autonumber
hide footbox
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 17
skinparam titleFontSize 24
skinparam titleFontColor #173955
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #436580
skinparam ArrowThickness 1.3
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F4F8FD
skinparam classBorderColor #7294B3
skinparam classFontColor #173955
skinparam classAttributeFontSize 15
skinparam stereotypeFontSize 13
skinparam stereotypeFontColor #58758E
skinparam nodesep 50
skinparam ranksep 58
skinparam linetype polyline
skinparam sequenceParticipantBackgroundColor #EAF1F8
skinparam sequenceParticipantBorderColor #7294B3
skinparam sequenceParticipantFontSize 15
skinparam sequenceLifeLineBorderColor #B7C8D7
skinparam sequenceGroupBackgroundColor #F5F8FB
skinparam sequenceGroupBorderColor #A3B8CA
skinparam sequenceGroupFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceMessageFontSize 16
skinparam sequenceArrowThickness 1.3
skinparam maxMessageSize 300
hide empty members
hide circle
title Consultar la retención de clientes por cohorte\n<size:14>Historias relacionadas: SCRUM-36</size>\n<size:14>CRM MaxiConecta | Diagrama de secuencia</size>
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/cohorte/AnalisisCohortes.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/cohorte/HistorialCohortes.java
' Fuente: backend/servicio-comportamiento/src/main/java/com/maxiconecta/crm/comportamiento/cohorte/CalculadoraRetencion.java
actor "Analista comercial" as U
participant CohortesController as C
participant AnalisisCohortes as A
participant HistorialCohortes as H
participant CalculadoraRetencion as R
U -> C : Seleccionar el rango de meses de primera compra\nGET /api/comportamiento/cohortes
C -> A : Analizar la retención del rango\nanalizar(desde, hasta)
A -> H : Obtener actividad por cohorte y mes\nactividad(inicio, fin, ahora, zona)
H --> A : Clientes de cada cohorte que compraron en cada mes
A -> R : Calcular la retención mensual\ncalcular(actividad, inicio, fin, mesActual)
R --> A : Tamaño de cada cohorte y porcentaje de clientes retenidos
A --> C : MatrizRetencion
C --> U : Matriz de retención por cohorte y mes
@enduml

# Copiar a .env y completar. .env no se versiona.
DB_USUARIO=crm
DB_PASSWORD=
# Al menos 32 caracteres.
JWT_SECRETO=
ADMIN_USUARIO=admin
ADMIN_PASSWORD=

# Puerto del API Gateway para el nginx del VPS; solo localhost.
GATEWAY_PUERTO=127.0.0.1:8080

# Publicación real del saldo y nivel de puntos (RIO-CRM-06) en Google Cloud Pub/Sub.
FIDELIZACION_SALIDA_PROYECTO=ID-DEL-PROYECTO-GCP
FIDELIZACION_SALIDA_TOPICO=ucb-sis323-sub-b
# Ruta absoluta a la clave JSON de la cuenta de servicio, FUERA del repositorio.
GCP_CREDENCIALES_ARCHIVO=/ruta/fuera/del/repo/clave-pubsub.json
# false pausa los envíos sin perder los pendientes.
FIDELIZACION_SALIDA_ENABLED=true

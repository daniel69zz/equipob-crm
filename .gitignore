# ===========================================================
# CRM MaxiConecta — .gitignore
# ===========================================================

# --- Configuración local ---
.mcp.json

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDEs y editores ---
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~

# --- Java / Maven / Gradle (backend) ---
target/
build/
.gradle/
out/
*.class
*.jar
*.war
!**/.mvn/wrapper/maven-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar
hs_err_pid*.log

# --- Node / Angular (frontend) ---
node_modules/
dist/
.angular/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Variables de entorno y secretos ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
application-local.yml
application-local.properties

# --- Logs y temporales ---
logs/
*.log
tmp/
*.tmp

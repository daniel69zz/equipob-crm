# Nginx de entrada: enruta por dominio al sitio web y a la API. Los microservicios no se publican;
# solo el API Gateway los consulta por la red interna de Docker. ${DOMINIO_WEB} y ${DOMINIO_API}
# se reemplazan al arrancar el contenedor (imagen oficial de nginx, carpeta templates).

# Un nombre de host desconocido (o la IP directa) se rechaza sin respuesta.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

# Sitio web: la SPA de Angular. Sus llamadas a /api van al Gateway en el mismo dominio (sin CORS).
server {
    listen 80;
    server_name ${DOMINIO_WEB};
    root /usr/share/nginx/html;
    client_max_body_size 10m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass http://api-gateway:8080;
        include /etc/nginx/conf.d/proxy-cabeceras.inc;
    }

    # Los archivos de Angular llevan hash en el nombre: se pueden cachear.
    location ~* \.(?:js|css|woff2?|png|svg|ico)$ {
        expires 30d;
        try_files $uri =404;
    }

    # Rutas de la SPA: cualquier ruta desconocida carga index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

# API: todo el dominio va al API Gateway, que valida el JWT o el token de servicio y consulta a los microservicios.
server {
    listen 80;
    server_name ${DOMINIO_API};
    client_max_body_size 10m;

    location / {
        proxy_pass http://api-gateway:8080;
        include /etc/nginx/conf.d/proxy-cabeceras.inc;
    }
}

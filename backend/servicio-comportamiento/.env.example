# Copiar como .env (ignorado por git) y completar los valores.

PUERTO=8082

SERVICIO_PERFIL_URL=http://localhost:8081
PERFIL_TIEMPO_ESPERA=2s

DB_URL=jdbc:postgresql://localhost:5432/crm_maxiconecta
DB_USUARIO=crm
DB_PASSWORD=cambiar

# Valor acumulado (en bolivianos) desde el que un cliente es de consumo medio y alto (SCRUM-27).
NIVEL_CONSUMO_UMBRAL_MEDIO=500
NIVEL_CONSUMO_UMBRAL_ALTO=5000

# Detección de cambios de comportamiento (SCRUM-34): ventana en días, periodos de la línea base,
# compras mínimas en la línea base y umbral de variación (0.5 = 50 %).
CAMBIO_COMPORTAMIENTO_VENTANA_DIAS=90
CAMBIO_COMPORTAMIENTO_PERIODOS_BASE=3
CAMBIO_COMPORTAMIENTO_MINIMO_COMPRAS_BASE=3
CAMBIO_COMPORTAMIENTO_UMBRAL=0.5

RABBIT_HOST=localhost
RABBIT_PUERTO=5672
RABBIT_USUARIO=crm
RABBIT_PASSWORD=cambiar

# Copiar como .env (ignorado por git) y completar los valores.

PUERTO=8082

SERVICIO_PERFIL_URL=http://localhost:8081
PERFIL_TIEMPO_ESPERA=2s

DB_URL=jdbc:postgresql://localhost:5432/crm_maxiconecta
DB_USUARIO=crm
DB_PASSWORD=cambiar

# Valor acumulado (en bolivianos) desde el que un cliente es de consumo medio y alto (SCRUM-27).
NIVEL_CONSUMO_UMBRAL_MEDIO=500
NIVEL_CONSUMO_UMBRAL_ALTO=5000

RABBIT_HOST=localhost
RABBIT_PUERTO=5672
RABBIT_USUARIO=crm
RABBIT_PASSWORD=cambiar

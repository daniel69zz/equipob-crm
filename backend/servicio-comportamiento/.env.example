# Copiar como .env (ignorado por git) y completar los valores.

PUERTO=8082

SERVICIO_PERFIL_URL=http://localhost:8081
PERFIL_TIEMPO_ESPERA=2s

# Servicio de segmentación, que informa los clientes de un segmento al comparar periodos (SCRUM-40).
SERVICIO_SEGMENTACION_URL=http://localhost:8083
SEGMENTACION_TIEMPO_ESPERA=2s

# Zona horaria del negocio para asignar cada compra a su día en el consumo por periodo (SCRUM-39).
CONSUMO_PERIODO_ZONA_HORARIA=America/La_Paz

DB_URL=jdbc:postgresql://localhost:5432/crm_maxiconecta
DB_USUARIO=crm
DB_PASSWORD=cambiar

RABBIT_HOST=localhost
RABBIT_PUERTO=5672
RABBIT_USUARIO=crm
RABBIT_PASSWORD=cambiar

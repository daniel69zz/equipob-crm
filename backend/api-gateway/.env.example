# Copiar como .env (ignorado por git) y completar los valores.

PUERTO=8080

DB_URL=jdbc:postgresql://localhost:5432/crm_maxiconecta
DB_USUARIO=crm
DB_PASSWORD=cambiar

# Mínimo 32 caracteres, aleatorio.
JWT_SECRETO=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRACION_MINUTOS=60

# Administrador que se crea al arrancar si la base no tiene usuarios.
ADMIN_USUARIO=admin
ADMIN_NOMBRE=Administrador del CRM
ADMIN_PASSWORD=cambiar

SERVICIO_PERFIL_URL=http://localhost:8081
SERVICIO_COMPORTAMIENTO_URL=http://localhost:8082
SERVICIO_SEGMENTACION_URL=http://localhost:8083
SERVICIO_FIDELIZACION_URL=http://localhost:8084
SERVICIO_INTERACCIONES_URL=http://localhost:8085

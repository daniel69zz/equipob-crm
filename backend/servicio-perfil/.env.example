# Copiar como .env (ignorado por git) y completar los valores.

PUERTO=8081

DB_URL=jdbc:postgresql://localhost:5432/crm_maxiconecta
DB_USUARIO=crm
DB_PASSWORD=cambiar

RABBIT_HOST=localhost
RABBIT_PUERTO=5672
RABBIT_USUARIO=crm
RABBIT_PASSWORD=cambiar

# Google Cloud Pub/Sub en lugar de RabbitMQ (docs/mensajeria/pubsub.md): activar con SPRING_PROFILES_ACTIVE=pubsub.
# SPRING_PROFILES_ACTIVE=pubsub
# PUBSUB_PROYECTO=crm-maxiconecta
# PUBSUB_EMULADOR=localhost:8085
